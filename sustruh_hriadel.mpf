; ============================================================
; PROGRAM: sustruh_hriadel.mpf
; POPIS:   Stupnovity hriadel - WinNC Sinumerik 840D
; POLOTOVAR: Tyc fi50 x 120mm, material: ocel C45
;
; KRESBA KUSU (pohad z boku):
;
;   |<-- 30mm -->|<---- 50mm ---->|<-- 20mm -->|
;   |            |                |            |
;   +--fi30------+------fi45------+----fi50----+ (celo)
;   |  (zavit M30 vonkajsi)       |   (surovy) |
;
;   Postup: surovanie, docistenie, zazraznenie
; ============================================================

%_N_SUSTRUH_HRIADEL_MPF
;$PATH=/_N_WKS_DIR/_N_HRIADEL_WPD

; --- UVODNE NASTAVENIA ---
G71          ; metricky system (mm)
G90          ; absolutne suradnice
G95          ; posuv v mm/ot
G40          ; zrusenie korekcie polom nastroja

; --- VYMENA NASTROJA: Hrube sustruzenie ---
T1 D1        ; nastroj T1 - hruba sustrunova platnicka (CNMG 120408)
M6           ; vymena nastroja
S600 M3      ; 600 ot/min, otacky vpravo
F0.3         ; posuv 0.3 mm/ot
M8           ; zapnutie chladenia

; ============================================================
; FAZA 1: HRUBE SUSTRUZENIE - odsustruzit na fi46 (prisdavok 0.5mm)
; ============================================================

G0 X55 Z5    ; rychloposuv na zaciatocnu poziciu (mimo kus)
G0 X46 Z2    ; priblizenie na priemer fi46

; --- Hrube sustruzenie casek fi45 (dlzka 50mm) ---
G1 Z-50      ; sustruzenie do hlbky Z=-50
G0 X55       ; odsunutie od kusu
G0 Z2        ; navrat

; --- Hrube sustruzenie fi30 casek (dlzka 30mm) ---
G0 X34       ; priblizenie na priemer fi34
G1 Z-30      ; sustruzenie do Z=-30
G0 X55       ; odsunutie
G0 Z2        ; navrat

; ============================================================
; FAZA 2: DOKONCOVACI CYKLUS SUSTRUZENIA (CYCLE95)
; ============================================================

; Vymena na dokoncovaci nastroj
T2 D1        ; nastroj T2 - docistovacia platnicka (VBMT 110304)
M6
S1200 M3     ; 1200 ot/min
F0.1         ; posuv 0.1 mm/ot (jemny)
M8

; Kontura kusu je definovana v podprograme _KONTURA
CYCLE95("_KONTURA", 0.5, 0, 0.3, 0, 0.1, 0.1, 0.1, 9, 0.5, 1, 0)
; CYCLE95(kontura, hlbka rezu, X-prisdavok, Z-prisdavok,
;         DXY, DZ, VRT, FAL, VARI, MID, FALZ, FALX)

; ============================================================
; FAZA 3: ZAZRAZNENIE (CHAMFER) HRANY
; ============================================================

G0 X28 Z2          ; pozicia pred zazrazenim
G1 X30 Z-1 F0.1    ; zazraznenie 1x45° na fi30
G1 Z-30            ; hrana schoda
G1 X45 Z-31 F0.1   ; zazraznenie 1x45° prechod
G1 Z-80            ; druha casek
G1 X50 Z-81        ; zazraznenie na konci fi45
G0 X55             ; odsunutie

; ============================================================
; FAZA 4: ZAPICHOVANIE ZAZRIEB (pre prstenec)
; ============================================================

T3 D1              ; nastroj T3 - zapichovaci noz 3mm
M6
S500 M3
F0.05              ; jemny posuv pre zapichovanie
M8

; Zazrieb pri Z=-30 (prechod fi30 -> fi45)
G0 X50 Z-28        ; pozicia nad zazriebom
G1 X26 F0.05       ; zapichnutie na fi26 (hlbka 2mm od fi30)
G4 F0.5            ; prodleva 0.5s (vycistenie)
G1 X50 F0.3        ; odtiahnutie

; ============================================================
; KONIEC PROGRAMU
; ============================================================

G0 X100 Z100   ; bezpecna pozicia
M9             ; vypnutie chladenia
M5             ; zastavenie vretena
M30            ; koniec programu

; ============================================================
; PODPROGRAM KONTURY
; ============================================================

PROC _KONTURA
G1 X0 Z0       ; stred cela (pre celove sustruzenie ak treba)
G1 X30 Z0      ; zacatok fi30 na cele
G1 X30 Z-30    ; casek fi30, dlzka 30mm
G1 X45 Z-30    ; schod na fi45
G1 X45 Z-80    ; casek fi45, dlzka 50mm
G1 X50 Z-80    ; schod na fi50 (surovy priemer)
M17            ; navrat z podprogramu
