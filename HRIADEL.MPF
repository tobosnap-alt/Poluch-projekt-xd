; ================================================================
; HLAVNY PROGRAM : HRIADEL.MPF
; Riadenie       : WinNC Sinumerik 840D - Sustruh
; Kus            : Stupnovity hriadel
; Polotovar      : Tyc fi50 x 120 mm, ocel C45
; Nulovy bod     : Celo kusu Z=0, stred osi X=0
;
;   Z-80      Z-30    Z0
;    |         |      |
;    +--fi45---+--fi30-+  <-- CELO
;   (50mm)   (30mm)
;
; L1 = Hrubovanie
; L2 = Docistovanie
; L3 = Zazraznenie hran
; L4 = Zapich
; ================================================================

G71   G90   G95   G40              ; mm, absolutne suradnice, posuv mm/ot, bez korekcie R

T1 D1   M6   S600 M3   F0.3   M8  ; T1 hruba platnicka, 600ot/min, F0.3, chladenie ZAP
L1                                 ; --> PODPROGRAM: Hrubovanie

T2 D1   M6   S1200 M3   F0.12  M8 ; T2 docistovacia platnicka, 1200ot/min, F0.12
L2                                 ; --> PODPROGRAM: Docistovanie
L3                                 ; --> PODPROGRAM: Zazraznenie hran (rovnaky nastroj T2)

T3 D1   M6   S500 M3   F0.05   M8 ; T3 zapichovaci noz 3mm, 500ot/min, F0.05
L4                                 ; --> PODPROGRAM: Zapich

G0 X120 Z50   M9   M5   M30       ; odsun, chladenie VYP, vreteno STOP, KONIEC
